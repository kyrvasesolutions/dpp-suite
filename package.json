{
  "name": "dpp-traceability",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "server": "npm run build:server && node dist-server/server.mjs",
    "typecheck": "tsc",
    "preview": "vite preview",
    "generate-icons": "pwa-assets-generator",
    "build-seed": "node scripts/build-seed.mjs",
    "check-legal-text": "node scripts/check-legal-text.mjs",
    "check-ontology-terms": "node scripts/check-ontology-terms.mjs",
    "check-data-spaces": "node scripts/check-data-spaces.mjs",
    "check-labels": "node scripts/check-labels.mjs",
    "fetch-idta": "node scripts/fetch-idta.mjs",
    "check-idta": "node scripts/fetch-idta.mjs --check",
    "check-contracts": "node scripts/check-contracts.mjs",
    "check-fixtures": "node scripts/check-fixtures.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check-bundle": "node scripts/check-bundle.mjs",
    "golden": "node scripts/golden.mjs",
    "serve": "vite preview --port 4173 --strictPort",
    "check-secrets": "node scripts/check-secrets.mjs",
    "check-audit": "node scripts/check-audit.mjs",
    "check-licences": "node scripts/check-licences.mjs",
    "audit-deps": "npm audit --omit=dev --audit-level=high",
    "rehearse-install": "bash scripts/rehearse-install.sh",
    "acceptance": "node scripts/acceptance.mjs",
    "perf": "node scripts/perf.mjs",
    "load": "node scripts/load.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "d3-force": "3.0.1",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/d3-force": "3.0.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "29.1.1",
    "pdfjs-dist": "6.5.438",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": ">=24"
  }
}
