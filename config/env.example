# Configuration points of the DPP demonstrator. Copy this file to `.env.local`, or export the variables in the shell,
# before `npm run build`, `npm run test` or the contract checkers. Nothing here is a secret and nothing may become one:
# a key, a token or a password never goes in this file or in any tracked file (`npm run check-secrets` enforces it).

# Contract pack the build and the tests read. Empty: the public stand-in pack in contracts/n.
# A local build can point at a private pack; `npm run check-bundle` refuses such a build for publication.
DPP_CONTRACT_PACK=

# Synthetic fixtures that follow that pack. Empty: derived from the pack (fixtures/n for contracts/n).
DPP_FIXTURE_PACK=

# Claude suggestions in the browser. Off unless set to "true"; with it off the bundle holds no Claude client.
# The Claude API key is entered in the page and kept in browser storage only. It is never a build variable.
VITE_ENABLE_LLM=false

# Path the built site is served from. "/" for a local `npm run serve`; "/<repository>/" on GitHub Pages.
BASE_PATH=/
