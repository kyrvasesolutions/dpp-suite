# Configuration points of the DPP demonstrator. Copy this file to `.env.local`, or export the variables in the shell,
# before `npm run build`, `npm run test` or the contract checkers. Nothing here is a secret and nothing may become one:
# a key, a token or a password never goes in this file or in any tracked file (`npm run check-secrets` enforces it).

# Contract pack the build and the tests read. Empty: the public stand-in pack in contracts/n.
# A local build can point at a private pack; `npm run check-bundle` refuses such a build for publication.
DPP_CONTRACT_PACK=

# Synthetic fixtures that follow that pack. Empty: derived from the pack (fixtures/n for contracts/n).
DPP_FIXTURE_PACK=

# Claude suggestions in the browser. Off unless set to "true"; with it off the bundle holds no Claude client.
# The Claude API key is entered in the page and kept in browser storage only. It is never a build variable.
VITE_ENABLE_LLM=false

# Path the built site is served from. "/" for a local `npm run serve`; "/<repository>/" on GitHub Pages.
BASE_PATH=/

# Browser to server. Leave EMPTY when the DPP server serves the app (`npm run server` serves the built `dist/`): the app then
# finds the server on its own origin (/api/health) and submits imports to it as jobs; the content security policy needs no
# exception. With no server (the static build, GitHub Pages) records stay in browser storage. A non-empty value names another
# origin and is blocked by the app's `connect-src 'self'` policy unless the build's policy is changed, so do not use it.
VITE_API_BASE=

# The local DPP server (`npm run server`, Node 24, SQLite). There is NO authentication until operators are identified
# (Cycle 7): keep it on this machine.
# Path to the SQLite WAL database (default: data/dpp.sqlite). Back it up with the server stopped, or with a hot copy
# (VACUUM INTO); never copy the -wal file on its own.
DPP_DB_PATH=data/dpp.sqlite

# Address the server binds to. 127.0.0.1 (this machine only) is the default and the only supported value today; a Host
# header naming anything else is refused (DNS-rebinding guard).
DPP_SERVER_HOST=127.0.0.1

# Local TCP port for `npm run server`.
DPP_SERVER_PORT=4174

# Extra browser origins allowed to call the API, comma separated (for example a Vite dev client on http://localhost:5173).
# Empty: only the server's own origin, and clients that send no Origin (curl, scripts), are accepted. Never "*".
DPP_ALLOWED_ORIGIN=

# Built single-page app the server serves on its own origin. Empty: `dist` if it exists, otherwise the API only.
DPP_STATIC_DIR=
